# ==========================================
# LoFilm - Environment Variables Configuration
# ==========================================

# --- Website Domain Configuration ---
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
INTERNAL_API_URL=https://phimapi.com/v1/api
NEXT_PUBLIC_INTERNAL_API_URL=https://phimapi.com/v1/api

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Redis Caching Configuration ---
# 1. Upstash Redis (Serverless HTTP/REST)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# 2. Redis Connection URL (Optional - ioredis for high performance Node.js runtime)
# REDIS_URL=redis://default:password@your-redis-host:6379

# --- Storage & CDN (Cloudflare R2 / AWS S3) ---
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-id.r2.dev
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Security & Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Production admin, crawler, notification and infrastructure credentials are
# intentionally not part of the portfolio edition.
